{# Keep blog cards together so section column settings apply to the rows. #}
{% if title %}<h3>{{ title }}</h3>{% endif %}
<div class="c-article-list">
  {% for row in rows %}
    <div{{ row.attributes.addClass(default_row_class ? 'views-row', 'c-article-list__row') }}>
      {{ row.content }}
    </div>
  {% endfor %}
</div>

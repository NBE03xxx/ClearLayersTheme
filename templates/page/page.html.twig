<div class="layout-container site-shell">
  {% if page.alert %}
    <div class="l-container">
      {{ page.alert }}
    </div>
  {% endif %}
  {# /alert #}

  {% block header %}
    {{ page.branding }}
  {% endblock %}
  {# /header #}

  {% block navigation %}
    {{ page.navigation }}
  {% endblock %}

  {% block breadcrumb %}
    {{page.breadcrumb}}
  {% endblock %}
  {# /breadcrumb #}

  {% block highlighted %}
    {{ page.highlighted }}
  {% endblock %}

  {% block help %}
    {{ page.help }}
  {% endblock %}


  {% block main %}
    <main id="main-content" class="site-shell__main" tabindex="-1">

      {% block content %}
        <div class="l-container lg-page-flow">
          {{ page.content }}
        </div>
      {% endblock %}
      {# /content #}

    </main>
  {% endblock %}
  {# /main #}

  {% block footer %}
    {{ page.footer }}
  {% endblock %}
  {# /footer #}

</div>
{# /.layout-container #}

{#
/**
 * @file
 * Molecule component for Menu - Tabs
 *
 * Available props:
 * - attributes - [string] Any additional attributes needing to be specified.
 * - menu_tabs_content - [object] Expecting all elemental parts of this menu.
 * - menu_tabs_label - [string] Expecting an identifying value.
 *
 * Available slots:
 * - menu_tabs_content
 * - menu_tabs_prefix
 *
 */
#}

{% set attributes = create_attribute(attributes)
  .setAttribute('role', 'navigation')
  .setAttribute('aria-label', menu_tabs_label)
%}

{% set classes = [
  'c-menu-tabs',
] %}

<nav {{ attributes.addClass(classes) }}>
  {% block menu_tabs_prefix %}{% endblock %}

  {% block menu_tabs_content %}
    {{ menu_tabs_content }}
  {% endblock %}
</nav>
